# Variables públicas de conexión a Supabase (ProyectoMillaray)
# Obtén estos valores en: Supabase Dashboard -> Project Settings -> Data API / API Keys
# Nota: La aplicación utiliza acceso público de SOLO LECTURA mediante políticas RLS.
# NUNCA incluyas aquí la clave privada service_role ni contraseñas de base de datos.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-publishable-o-anon-key

